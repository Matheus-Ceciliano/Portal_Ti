# Portal TI Vallur — modelo de variáveis de ambiente
#
# Contém SOMENTE nomes e valores de exemplo, nunca segredos reais.
# Em desenvolvimento, gere o .env (ignorado pelo Git) com: npm run preparar
# Regras: docs/AMBIENTES.md.

# Ambiente da instalação (DA-23): DESENVOLVIMENTO | HOMOLOGACAO | PRODUCAO.
# Obrigatória. NODE_ENV não substitui esta variável.
AMBIENTE=DESENVOLVIMENTO

# Tenants Microsoft 365 autorizados para ESCRITA fora de produção (DA-23).
# Deve ficar vazia: a aplicação recusa iniciar com valor (Q-09).
TENANTS_ESCRITA_AUTORIZADOS=

# Modo dos conectores Microsoft 365 / Teams. Somente SIMULACAO é aceito nesta etapa.
MODO_INTEGRACOES=SIMULACAO

# Telemetria anônima do Next.js desativada.
NEXT_TELEMETRY_DISABLED=1

# PostgreSQL 17. Em desenvolvimento: npm run db (binários locais, sem Docker).
PG_PORTA=54329
PG_USUARIO=vallur_dev
PG_SENHA=<gerada por npm run preparar>
DATABASE_URL=postgresql://<usuario>:<senha>@localhost:54329/vallur_portal
DATABASE_URL_TESTE=postgresql://<usuario>:<senha>@localhost:54329/vallur_portal_teste

# Autenticação própria do portal (Better Auth, DA-24). Segredos com 32+ bytes aleatórios.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<aleatório>
# Pepper do Argon2id (DA-25): fora do banco. Trocar invalida todas as senhas.
SENHA_PEPPER=<aleatório>

# CPF cifrado na aplicação (DA-11): chave AES-256-GCM e chave do HMAC, diferentes, 32 bytes em
# base64url. Guarde cópia fora do servidor: perder a chave de cifra torna o CPF irrecuperável.
CPF_CHAVE_CIFRA=<aleatório>
CPF_CHAVE_HMAC=<aleatório>
