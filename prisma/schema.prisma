// Portal TI Vallur — esquema inicial da Etapa 1.
// Modelos ContaAcesso, Sessao, CredencialConta, Verificacao e FatorMfa são as tabelas
// da biblioteca de autenticação (Better Auth: user, session, account, verification,
// twoFactor), renomeadas para o domínio do portal. Nenhum campo guarda senha em texto.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SituacaoColaborador {
  PRE_CADASTRO
  ATIVO
  AFASTADO
  DESLIGADO
}

enum SituacaoConta {
  ATIVA
  BLOQUEADA
  DESATIVADA
}

enum Perfil {
  ESTAGIARIO_TI
  SUPERVISOR_TI
  GESTOR_ADM
}

enum VisaoPainel {
  OPERACIONAL
  GERENCIAL
}

enum ResultadoAuditoria {
  SUCESSO
  NEGADO
  FALHA
}

/// Ambiente gravado na criação do banco (DA-23). Comparado com AMBIENTE na inicialização.
model Instalacao {
  id       Int      @id @default(1)
  ambiente String
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("instalacao")
}

model Empresa {
  id                String               @id @default(uuid())
  /// Razão social.
  nome              String               @unique
  /// Nome curto ou sigla usada no dia a dia.
  sigla             String               @unique
  /// Nome curto usado na senha inicial de ativação (ex.: Virta, Arvos, Preserve). Não é a sigla.
  nomeCurtoSenha    String?              @map("nome_curto_senha")
  /// CNPJ canônico: 14 caracteres maiúsculos sem pontuação (aceita o formato alfanumérico).
  cnpj              String               @unique
  cidade            String
  ativa             Boolean              @default(true)
  /// Nome da pessoa responsável pela empresa (texto livre; não é vínculo de colaborador).
  responsavel       String?
  observacoes       String?
  /// Chave do logotipo no armazenamento privado; nunca é um caminho do sistema de arquivos.
  logoChave         String?              @map("logo_chave")
  logoTipo          String?              @map("logo_tipo")
  criadoEm          DateTime             @default(now()) @map("criado_em")
  atualizadoEm      DateTime             @default(now()) @updatedAt @map("atualizado_em")
  colaboradores     Colaborador[]
  /// Equipamentos de que a empresa é proprietária.
  ativos            Ativo[]
  /// Alocações a colaboradores da empresa (instantâneo do vínculo na data da alocação).
  alocacoes         Alocacao[]
  itensProprios     ItemAlocacao[]
  /// Aluguéis entre empresas: equipamentos cedidos (como proprietária) e recebidos (como locatária).
  /// TERs em que a empresa é a responsável.
  termos            Termo[]
  alugueisCedidos   AluguelEquipamento[] @relation("AlugueisCedidos")
  alugueisRecebidos AluguelEquipamento[] @relation("AlugueisRecebidos")

  @@map("empresa")
}

model Colaborador {
  id                    String                @id @default(uuid())
  nome                  String
  emailCorporativo      String                @unique @map("email_corporativo")
  /// Cargo e departamento: texto livre; vazio quando ainda não informado.
  cargo                 String
  departamento          String
  empresaId             String                @map("empresa_id")
  empresa               Empresa               @relation(fields: [empresaId], references: [id])
  situacao              SituacaoColaborador   @default(ATIVO)
  /// Identidade Microsoft para integrações. Nunca é chave de login (DT-01).
  entraObjectId         String?               @unique @map("entra_object_id")
  /// Composição de nomes usada nos identificadores (planilha IAM - Novo Usuário).
  segundoNome           String?               @map("segundo_nome")
  sobrenomeUtilizado    String?               @map("sobrenome_utilizado")
  /// Identificadores de acesso. Calculados no cadastro e, depois, só mudam por ação explícita.
  nomeServidorPc        String?               @map("nome_servidor_pc")
  /// Unicidade do usuário do servidor/PC: minúsculas, sem acentos e espaços simples.
  chaveServidorPc       String?               @unique @map("chave_servidor_pc")
  loginUau              String?               @unique @map("login_uau")
  loginMicrosoft        String?               @unique @map("login_microsoft")
  grupoLicencaId        String?               @map("grupo_licenca_id")
  grupoLicenca          GrupoLicenca?         @relation(fields: [grupoLicencaId], references: [id])
  /// Foto no armazenamento privado (chave, nunca caminho do sistema de arquivos).
  fotoChave             String?               @map("foto_chave")
  fotoTipo              String?               @map("foto_tipo")
  criadoEm              DateTime              @default(now()) @map("criado_em")
  atualizadoEm          DateTime              @updatedAt @map("atualizado_em")
  conta                 ContaAcesso?
  perfis                PerfilAtribuido[]
  permissoesIndividuais PermissaoIndividual[]
  /// CPF cifrado na aplicação (AES-256-GCM, DA-11); só um caso de uso autorizado o decifra
  /// (geração do TER, com auditoria). Nunca aparece em listas, logs ou auditoria.
  cpfCifrado            Bytes?                @map("cpf_cifrado")
  /// HMAC-SHA-256 do CPF (chave separada): unicidade e busca exata, sem revelar o número.
  cpfHmac               String?               @unique @map("cpf_hmac")
  /// Últimos dois dígitos, para a exibição mascarada (***.***.***-12).
  cpfFinal              String?               @map("cpf_final")
  alocacoes             Alocacao[]
  devolucoes            Devolucao[]
  termos                Termo[]

  @@index([empresaId])
  @@index([grupoLicencaId])
  @@map("colaborador")
}

/// Grupo de licença Microsoft (catálogo local). Define os domínios de login e de e-mail;
/// não comprova licença atribuída nem domínio verificado no tenant.
model GrupoLicenca {
  id            String        @id @default(uuid())
  nome          String        @unique
  dominioLogin  String        @map("dominio_login")
  dominioEmail  String        @map("dominio_email")
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now()) @map("criado_em")
  atualizadoEm  DateTime      @default(now()) @updatedAt @map("atualizado_em")
  colaboradores Colaborador[]

  @@map("grupo_licenca")
}

model PerfilAtribuido {
  id            String      @id @default(uuid())
  colaboradorId String      @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  perfil        Perfil
  justificativa String
  atribuidoPor  String?     @map("atribuido_por")
  atribuidoEm   DateTime    @default(now()) @map("atribuido_em")
  revogadoPor   String?     @map("revogado_por")
  revogadoEm    DateTime?   @map("revogado_em")

  @@index([colaboradorId])
  @@map("perfil_atribuido")
}

model PermissaoIndividual {
  id            String      @id @default(uuid())
  colaboradorId String      @map("colaborador_id")
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  permissao     String
  justificativa String
  concedidaPor  String      @map("concedida_por")
  concedidaEm   DateTime    @default(now()) @map("concedida_em")
  validaAte     DateTime?   @map("valida_ate")
  revogadaPor   String?     @map("revogada_por")
  revogadaEm    DateTime?   @map("revogada_em")

  @@index([colaboradorId])
  @@map("permissao_individual")
}

/// Conta de acesso ao portal (tabela "user" da biblioteca de autenticação).
model ContaAcesso {
  id                         String            @id
  name                       String
  email                      String            @unique
  emailVerified              Boolean           @default(false) @map("email_verified")
  image                      String?
  createdAt                  DateTime          @default(now()) @map("criado_em")
  updatedAt                  DateTime          @updatedAt @map("atualizado_em")
  twoFactorEnabled           Boolean?          @default(false) @map("mfa_habilitado")
  colaboradorId              String            @unique @map("colaborador_id")
  colaborador                Colaborador       @relation(fields: [colaboradorId], references: [id])
  situacao                   SituacaoConta     @default(ATIVA)
  /// Nulo enquanto vale a senha definida pela TI: a conta só acessa /conta/ativar.
  senhaPessoalDefinidaEm     DateTime?         @map("senha_pessoal_definida_em")
  /// Código de ativação do perfil de TI validado (etapa 1 da ativação).
  ativacaoTiCodigoValidadoEm DateTime?         @map("ativacao_ti_codigo_validado_em")
  /// Ativação do perfil de TI concluída (senha pessoal + MFA com código de uso único).
  ativacaoTiConcluidaEm      DateTime?         @map("ativacao_ti_concluida_em")
  visaoPainel                VisaoPainel?      @map("visao_painel")
  ultimoAcessoEm             DateTime?         @map("ultimo_acesso_em")
  sessoes                    Sessao[]
  credenciais                CredencialConta[]
  fatores                    FatorMfa[]
  codigosAtivacao            CodigoAtivacao[]
  codigosTotpUsados          CodigoTotpUsado[]
  alocacoesResponsavel       Alocacao[]        @relation("ResponsavelTiAlocacao")

  @@map("conta_acesso")
}

/// Sessão (tabela "session" da biblioteca). Revogar = excluir a linha.
model Sessao {
  id              String      @id
  expiresAt       DateTime    @map("expira_em")
  token           String      @unique
  createdAt       DateTime    @default(now()) @map("criada_em")
  updatedAt       DateTime    @updatedAt @map("atualizada_em")
  ipAddress       String?     @map("ip")
  userAgent       String?     @map("user_agent")
  userId          String      @map("conta_id")
  conta           ContaAcesso @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Segundo fator verificado nesta sessão (exigido para a área de TI).
  mfaVerificadoEm DateTime?   @map("mfa_verificado_em")
  ultimoUsoEm     DateTime?   @map("ultimo_uso_em")

  @@index([userId])
  @@map("sessao")
}

/// Credencial (tabela "account" da biblioteca). Só o provedor "credential" é usado.
model CredencialConta {
  id                    String      @id
  accountId             String      @map("account_id")
  providerId            String      @map("provider_id")
  userId                String      @map("conta_id")
  conta                 ContaAcesso @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?     @map("access_token")
  refreshToken          String?     @map("refresh_token")
  idToken               String?     @map("id_token")
  accessTokenExpiresAt  DateTime?   @map("access_token_expira_em")
  refreshTokenExpiresAt DateTime?   @map("refresh_token_expira_em")
  scope                 String?
  /// Hash Argon2id (formato PHC) com pepper. Nunca a senha.
  password              String?     @map("hash_senha")
  createdAt             DateTime    @default(now()) @map("criado_em")
  updatedAt             DateTime    @updatedAt @map("atualizado_em")

  @@index([userId])
  @@map("credencial_conta")
}

model Verificacao {
  id         String   @id
  identifier String   @map("identificador")
  value      String   @map("valor")
  expiresAt  DateTime @map("expira_em")
  createdAt  DateTime @default(now()) @map("criado_em")
  updatedAt  DateTime @updatedAt @map("atualizado_em")

  @@index([identifier])
  @@map("verificacao")
}

/// Segredo TOTP cifrado e códigos de recuperação cifrados (tabela "twoFactor" da biblioteca).
model FatorMfa {
  id                      String      @id
  secret                  String      @map("segredo_cifrado")
  backupCodes             String      @map("codigos_recuperacao_cifrados")
  userId                  String      @map("conta_id")
  conta                   ContaAcesso @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?    @default(true) @map("verificado")
  failedVerificationCount Int?        @default(0) @map("falhas_verificacao")
  lockedUntil             DateTime?   @map("bloqueado_ate")

  @@index([secret])
  @@index([userId])
  @@map("fator_mfa")
}

/// Código de ativação de perfil de TI: uso único, guardado só como HMAC, com validade.
model CodigoAtivacao {
  id           String      @id @default(uuid())
  contaId      String      @map("conta_id")
  conta        ContaAcesso @relation(fields: [contaId], references: [id], onDelete: Cascade)
  hashCodigo   String      @unique @map("hash_codigo")
  criadoPor    String?     @map("criado_por")
  criadoEm     DateTime    @default(now()) @map("criado_em")
  expiraEm     DateTime    @map("expira_em")
  usadoEm      DateTime?   @map("usado_em")
  invalidadoEm DateTime?   @map("invalidado_em")
  tentativas   Int         @default(0)

  @@index([contaId])
  @@map("codigo_ativacao")
}

/// Códigos TOTP já aceitos (impede reutilização dentro da janela de validade).
model CodigoTotpUsado {
  contaId    String      @map("conta_id")
  conta      ContaAcesso @relation(fields: [contaId], references: [id], onDelete: Cascade)
  hashCodigo String      @map("hash_codigo")
  usadoEm    DateTime    @default(now()) @map("usado_em")

  @@id([contaId, hashCodigo])
  @@map("codigo_totp_usado")
}

/// Limitador de tentativas por IP e por e-mail (HMAC), antes de qualquer hash (DA-27).
model LimiteTentativa {
  chave        String    @id
  falhas       Int       @default(0)
  janelaInicio DateTime  @map("janela_inicio")
  bloqueadoAte DateTime? @map("bloqueado_ate")

  @@map("limite_tentativa")
}

/// Trilha de auditoria. Somente metadados; nunca senha, hash ou segredo.
model EventoAuditoria {
  id              String             @id @default(uuid())
  criadoEm        DateTime           @default(now()) @map("criado_em")
  ambiente        String
  acao            String
  resultado       ResultadoAuditoria
  atorContaId     String?            @map("ator_conta_id")
  atorNome        String?            @map("ator_nome")
  alvoTipo        String?            @map("alvo_tipo")
  alvoId          String?            @map("alvo_id")
  alvoDescricao   String?            @map("alvo_descricao")
  origemPermissao String?            @map("origem_permissao")
  detalhe         Json?
  simulado        Boolean            @default(false)

  @@index([criadoEm])
  @@index([acao])
  @@map("evento_auditoria")
}

/**
 * Inventário, alocações, manutenções e termos (MODELO_DE_DADOS.md §8 e §9)
 */

enum CategoriaAtivo {
  NOTEBOOK
  DESKTOP
  MONITOR
  CELULAR
  IMPRESSORA
  CARREGADOR
  TECLADO
  MOUSE
  KIT_TECLADO_MOUSE
  HEADSET
  OUTRO
  /// Componentes internos (peças físicas do estoque de TI): instalados em notebooks, nunca alocados a pessoas.
  MEMORIA_RAM
  SSD
  HD
}

/// Transições válidas em src/lib/inventario.ts; só os casos de uso mudam a situação.
enum SituacaoAtivo {
  DISPONIVEL
  RESERVADO
  ALOCADO
  MANUTENCAO
  DEVOLVIDO_EM_AVALIACAO
  BAIXADO
  /// Componente instalado em um notebook (não é alocação a pessoa).
  INSTALADO
}

enum MotivoDesvinculoCarregador {
  TROCA
  PERDA
  DEFEITO
}

/// Equipamento com controle individual. O responsável atual não é coluna: deriva do item de
/// alocação em aberto de uma alocação ATIVA (entrega física, Q-27).
model Ativo {
  id                   String                      @id @default(uuid())
  /// Tipo (comportamento no portal: notebook, carregador, kit, peça interna...). O nome exibido vem da categoria do catálogo.
  categoria            CategoriaAtivo
  /// Categoria do catálogo (nome, abreviação e regra do identificador automático).
  categoriaId          String                      @map("categoria_id")
  categoriaEquipamento CategoriaEquipamento        @relation(fields: [categoriaId], references: [id])
  /// Notebook (cadastros anteriores ao catálogo de processadores): família escolhida no cadastro. Só histórico.
  familiaProcessadorId String?                     @map("familia_processador_id")
  familiaProcessador   FamiliaProcessador?         @relation(fields: [familiaProcessadorId], references: [id])
  /// Catálogos (Catálogos do Inventário). O texto em marca, modelo, processador e sistemaOperacional
  /// acompanha o item do catálogo; cadastros antigos guardam o texto original até a próxima edição.
  marcaId              String?                     @map("marca_id")
  marcaCatalogo        MarcaEquipamento?           @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  modeloId             String?                     @map("modelo_id")
  modeloCatalogo       ModeloEquipamento?          @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  /// Notebook: o processador define o código do identificador (Intel Core i5-1345U → 5 → NBI5001).
  processadorId        String?                     @map("processador_id")
  processadorCatalogo  Processador?                @relation(fields: [processadorId], references: [id], onDelete: Restrict)
  sistemaOperacionalId String?                     @map("sistema_operacional_id")
  sistemaCatalogo      SistemaOperacional?         @relation(fields: [sistemaOperacionalId], references: [id], onDelete: Restrict)
  /// Peça de um kit (KTM01.T, KTM01.M, KTM01.H): o kit é só o agrupador lógico.
  kitId                String?                     @map("kit_id")
  kit                  KitEquipamento?             @relation(fields: [kitId], references: [id])
  parteKit             ParteKit?                   @map("parte_kit")
  /// Nome do dispositivo (ex.: NBI5001), em maiúsculas. Obrigatório para notebook; carregador: <notebook>C<n>.
  nomeDispositivo      String?                     @unique @map("nome_dispositivo")
  /// Patrimônio, em maiúsculas. Obrigatório, exceto para carregador (identificado pelo nome).
  patrimonio           String?                     @unique
  /// Empresa proprietária. Não muda por alocação a colaborador de outra empresa.
  empresaId            String                      @map("empresa_id")
  empresa              Empresa                     @relation(fields: [empresaId], references: [id])
  marca                String
  modelo               String
  numeroSerie          String?                     @unique @map("numero_serie")
  processador          String?
  memoriaRam           String?                     @map("memoria_ram")
  armazenamento        String?
  sistemaOperacional   String?                     @map("sistema_operacional")
  /// Componente (RAM, SSD, HD): capacidade em GB, tecnologia (RAM), interface (SSD/HD), formato e frequência (RAM).
  capacidadeGb         Int?                        @map("capacidade_gb")
  tecnologia           String?
  interfaceConexao     String?                     @map("interface_conexao")
  formato              String?
  frequenciaMhz        Int?                        @map("frequencia_mhz")
  dataAquisicao        DateTime?                   @map("data_aquisicao") @db.Date
  garantiaAte          DateTime?                   @map("garantia_ate") @db.Date
  observacoes          String?
  situacao             SituacaoAtivo               @default(DISPONIVEL)
  situacaoDesde        DateTime                    @default(now()) @map("situacao_desde")
  /// Condição na entrada no inventário (define a inspeção de entrada); nula nos cadastros anteriores.
  condicaoEntrada      CondicaoEntrada?            @map("condicao_entrada")
  /// Carregador: notebook a que pertence e posição na sequência (C1, C2...).
  notebookId           String?                     @map("notebook_id")
  notebook             Ativo?                      @relation("Carregadores", fields: [notebookId], references: [id])
  carregadores         Ativo[]                     @relation("Carregadores")
  sequenciaCarregador  Int?                        @map("sequencia_carregador")
  /// Carregador trocado, perdido ou com defeito: o vínculo é encerrado e preservado no histórico.
  desvinculadoEm       DateTime?                   @map("desvinculado_em")
  motivoDesvinculo     MotivoDesvinculoCarregador? @map("motivo_desvinculo")
  /// O mesmo envio repetido (duplo clique, nova tentativa) devolve o cadastro já feito.
  chaveRequisicao      String?                     @unique @map("chave_requisicao")
  criadoPorNome        String?                     @map("criado_por_nome")
  criadoEm             DateTime                    @default(now()) @map("criado_em")
  atualizadoEm         DateTime                    @default(now()) @updatedAt @map("atualizado_em")
  fotos                FotoAtivo[]
  movimentacoes        MovimentacaoAtivo[]
  itensAlocacao        ItemAlocacao[]
  manutencoes          Manutencao[]
  transferencias       Transferencia[]
  alugueis             AluguelEquipamento[]
  inspecoes            InspecaoTecnica[]
  verificacoesEntrega  VerificacaoEntrega[]
  /// Notebook: peças da configuração (original e componentes instalados) e intervenções.
  pecasConfiguracao    PecaConfiguracao[]          @relation("PecasEquipamento")
  intervencoes         IntervencaoConfiguracao[]
  /// Componente: onde já esteve (ou está) instalado.
  instalacoes          PecaConfiguracao[]          @relation("PecasComponente")

  @@unique([notebookId, sequenciaCarregador])
  @@unique([kitId, parteKit])
  @@index([categoriaId])
  @@index([marcaId])
  @@index([modeloId])
  @@index([processadorId])
  @@index([sistemaOperacionalId])
  @@index([empresaId])
  @@index([situacao])
  @@index([categoria])
  @@map("ativo")
}

/// Regra do identificador automático da categoria.
enum RegraIdentificador {
  /// Notebook: prefixo + código da família do processador + sequência por família (NBI5001).
  PROCESSADOR
  /// Carregador: nome do notebook + C + sequência por notebook (NBI5001C1).
  CARREGADOR
  /// Kit: prefixo + sequência do kit; cada peça recebe .T, .M ou .H (KTM01.T).
  KIT
  /// Prefixo + sequência (MNT001).
  SEQUENCIAL
  /// Sem identificador automático: o patrimônio (ou um nome informado) identifica.
  NENHUMA
}

enum ParteKit {
  TECLADO
  MOUSE
  RECEPTOR
}

/// Catálogo de categorias do inventário. As do catálogo inicial ("sistema") não mudam de tipo
/// nem de regra e não são excluídas; nome, abreviação e situação podem mudar. Mudar a
/// abreviação vale só para os próximos equipamentos: os identificadores existentes ficam.
model CategoriaEquipamento {
  id            String                        @id @default(uuid())
  /// Código das categorias do catálogo inicial (igual ao tipo); nulo nas criadas pela TI.
  codigo        String?                       @unique
  nome          String                        @unique
  tipo          CategoriaAtivo
  regra         RegraIdentificador
  prefixo       String?                       @unique
  digitos       Int                           @default(3)
  ativa         Boolean                       @default(true)
  sistema       Boolean                       @default(false)
  ordem         Int                           @default(100)
  criadaEm      DateTime                      @default(now()) @map("criada_em")
  criadaPorNome String?                       @map("criada_por_nome")
  atualizadaEm  DateTime                      @default(now()) @updatedAt @map("atualizada_em")
  ativos        Ativo[]
  kits          KitEquipamento[]
  prefixos      HistoricoPrefixoCategoria[]
  modelos       ModeloEquipamento[]
  sistemas      SistemaOperacionalCategoria[]

  /// Checklist de inspeção da categoria (perguntas configuradas pela TI).
  perguntasInspecao PerguntaInspecao[]

  @@map("categoria_equipamento")
}

/// Abreviações anteriores de cada categoria (os equipamentos já identificados mantêm a antiga).
model HistoricoPrefixoCategoria {
  id              String               @id @default(uuid())
  categoriaId     String               @map("categoria_id")
  categoria       CategoriaEquipamento @relation(fields: [categoriaId], references: [id])
  prefixoAnterior String?              @map("prefixo_anterior")
  prefixoNovo     String?              @map("prefixo_novo")
  digitosAnterior Int                  @map("digitos_anterior")
  digitosNovo     Int                  @map("digitos_novo")
  alteradoEm      DateTime             @default(now()) @map("alterado_em")
  alteradoPorNome String               @map("alterado_por_nome")

  @@index([categoriaId, alteradoEm])
  @@map("historico_prefixo_categoria")
}

/// Famílias de processador usadas antes do catálogo de processadores (cada uma virou um item do
/// catálogo, com o mesmo código). Mantida só como histórico dos cadastros antigos.
model FamiliaProcessador {
  id            String   @id @default(uuid())
  nome          String   @unique
  codigo        String   @unique
  ativa         Boolean  @default(true)
  criadaEm      DateTime @default(now()) @map("criada_em")
  criadaPorNome String?  @map("criada_por_nome")
  ativos        Ativo[]

  @@map("familia_processador")
}

/**
 * Catálogos do Inventário. "chave" é o texto normalizado (sem acento, minúsculas, espaços
 * simples; função chave_catalogo no banco): Dell e DELL são a mesma marca. Itens com
 * equipamentos não são excluídos; a inativação só os tira das opções de novos cadastros.
 */

model MarcaEquipamento {
  id            String              @id @default(uuid())
  nome          String
  chave         String              @unique
  ativa         Boolean             @default(true)
  criadaEm      DateTime            @default(now()) @map("criada_em")
  criadaPorNome String?             @map("criada_por_nome")
  atualizadaEm  DateTime            @default(now()) @updatedAt @map("atualizada_em")
  modelos       ModeloEquipamento[]
  ativos        Ativo[]

  @@map("marca_equipamento")
}

/// Modelo de uma marca para uma categoria (Notebook · Dell · Latitude 5440).
model ModeloEquipamento {
  id            String               @id @default(uuid())
  nome          String
  chave         String
  marcaId       String               @map("marca_id")
  marca         MarcaEquipamento     @relation(fields: [marcaId], references: [id])
  categoriaId   String               @map("categoria_id")
  categoria     CategoriaEquipamento @relation(fields: [categoriaId], references: [id])
  ativa         Boolean              @default(true)
  criadaEm      DateTime             @default(now()) @map("criada_em")
  criadaPorNome String?              @map("criada_por_nome")
  atualizadaEm  DateTime             @default(now()) @updatedAt @map("atualizada_em")
  ativos        Ativo[]

  @@unique([marcaId, categoriaId, chave])
  @@index([categoriaId])
  @@map("modelo_equipamento")
}

/// Processador: modelo completo (Intel Core i5-1345U) e o código de nomenclatura do notebook
/// (5 → NBI5001). Sem código, o processador não gera identificador até a TI configurá-lo.
model Processador {
  id                 String   @id @default(uuid())
  fabricante         String?
  familia            String?
  modelo             String
  chave              String   @unique
  codigoNomenclatura String?  @map("codigo_nomenclatura")
  ativa              Boolean  @default(true)
  criadaEm           DateTime @default(now()) @map("criada_em")
  criadaPorNome      String?  @map("criada_por_nome")
  atualizadaEm       DateTime @default(now()) @updatedAt @map("atualizada_em")
  ativos             Ativo[]

  @@map("processador")
}

/// Sistema operacional (Windows 11 + Pro). Com categorias associadas, só aparece para elas.
model SistemaOperacional {
  id            String                        @id @default(uuid())
  nome          String
  versao        String?
  chave         String                        @unique
  ativa         Boolean                       @default(true)
  criadaEm      DateTime                      @default(now()) @map("criada_em")
  criadaPorNome String?                       @map("criada_por_nome")
  atualizadaEm  DateTime                      @default(now()) @updatedAt @map("atualizada_em")
  categorias    SistemaOperacionalCategoria[]
  ativos        Ativo[]

  @@map("sistema_operacional")
}

model SistemaOperacionalCategoria {
  sistemaId   String               @map("sistema_id")
  sistema     SistemaOperacional   @relation(fields: [sistemaId], references: [id], onDelete: Cascade)
  categoriaId String               @map("categoria_id")
  categoria   CategoriaEquipamento @relation(fields: [categoriaId], references: [id])

  @@id([sistemaId, categoriaId])
  @@map("sistema_operacional_categoria")
}

enum TipoPadraoMemoria {
  TECNOLOGIA
  FORMATO
  FREQUENCIA
}

/// Padrões técnicos das memórias RAM (DDR4, SO-DIMM, 3200 MHz): características, não peças físicas.
model PadraoMemoria {
  id            String            @id @default(uuid())
  tipo          TipoPadraoMemoria
  valor         String
  chave         String
  ativa         Boolean           @default(true)
  ordem         Int               @default(100)
  criadaEm      DateTime          @default(now()) @map("criada_em")
  criadaPorNome String?           @map("criada_por_nome")

  @@unique([tipo, chave])
  @@map("padrao_memoria")
}

/// Kit de teclado e mouse: agrupador lógico (KTM01) das peças físicas cadastradas juntas.
model KitEquipamento {
  id              String               @id @default(uuid())
  codigo          String               @unique
  categoriaId     String               @map("categoria_id")
  categoria       CategoriaEquipamento @relation(fields: [categoriaId], references: [id])
  criadoEm        DateTime             @default(now()) @map("criado_em")
  criadoPorNome   String               @map("criado_por_nome")
  /// O mesmo envio repetido devolve o kit já cadastrado.
  chaveRequisicao String?              @unique @map("chave_requisicao")
  partes          Ativo[]

  @@map("kit_equipamento")
}

enum TipoFoto {
  FRONTAL
  TELA
  TECLADO
  LATERAIS
  INFERIOR
  ETIQUETA_SERIE
  CARREGADOR
  OUTRA
}

enum ContextoFoto {
  CADASTRO
  MANUTENCAO
  CONCLUSAO_MANUTENCAO
  DEVOLUCAO
  INSPECAO
}

/// Foto no armazenamento privado (nunca no banco). Fotos de eventos passados não são substituídas.
model FotoAtivo {
  id              String            @id @default(uuid())
  ativoId         String            @map("ativo_id")
  ativo           Ativo             @relation(fields: [ativoId], references: [id])
  contexto        ContextoFoto
  tipo            TipoFoto
  chave           String            @unique
  mime            String
  tamanho         Int
  manutencaoId    String?           @map("manutencao_id")
  manutencao      Manutencao?       @relation(fields: [manutencaoId], references: [id])
  itemDevolucaoId String?           @map("item_devolucao_id")
  itemDevolucao   ItemDevolucao?    @relation(fields: [itemDevolucaoId], references: [id])
  /// Evidência de uma inspeção técnica (e da pergunta, quando anexada a ela).
  inspecaoId      String?           @map("inspecao_id")
  inspecao        InspecaoTecnica?  @relation(fields: [inspecaoId], references: [id])
  respostaId      String?           @map("resposta_id")
  resposta        RespostaInspecao? @relation(fields: [respostaId], references: [id])
  enviadaPorNome  String            @map("enviada_por_nome")
  enviadaEm       DateTime          @default(now()) @map("enviada_em")
  /// Foto do cadastro retirada na edição: some das galerias, mas o arquivo e o registro ficam.
  removidaEm      DateTime?         @map("removida_em")
  removidaPorNome String?           @map("removida_por_nome")

  @@index([ativoId])
  @@index([inspecaoId])
  @@map("foto_ativo")
}

enum TipoMovimentacao {
  CADASTRO
  EDICAO
  TRANSFERENCIA_EMPRESA
  RESERVA
  CANCELAMENTO_RESERVA
  ENTREGA
  DEVOLUCAO
  ENVIO_MANUTENCAO
  CONCLUSAO_MANUTENCAO
  LIBERACAO_AVALIACAO
  CARREGADOR_VINCULADO
  CARREGADOR_DESVINCULADO
  TRANSFERENCIA_COLABORADOR
  CONFIGURACAO_ORIGINAL
  COMPONENTE_INSTALADO
  COMPONENTE_REMOVIDO
  COMPONENTE_SUBSTITUIDO
  ALUGUEL_INICIADO
  ALUGUEL_ENCERRADO
}

/// Livro-razão de cada equipamento: somente inserção.
model MovimentacaoAtivo {
  id                  String           @id @default(uuid())
  ativoId             String           @map("ativo_id")
  ativo               Ativo            @relation(fields: [ativoId], references: [id])
  tipo                TipoMovimentacao
  situacaoAnterior    SituacaoAtivo?   @map("situacao_anterior")
  situacaoNova        SituacaoAtivo?   @map("situacao_nova")
  /// Colaborador envolvido (quem recebeu, devolveu ou estava com o equipamento).
  colaboradorId       String?          @map("colaborador_id")
  colaboradorNome     String?          @map("colaborador_nome")
  alocacaoId          String?          @map("alocacao_id")
  manutencaoId        String?          @map("manutencao_id")
  devolucaoId         String?          @map("devolucao_id")
  realizadoPorContaId String?          @map("realizado_por_conta_id")
  realizadoPorNome    String           @map("realizado_por_nome")
  realizadoEm         DateTime         @default(now()) @map("realizado_em")
  observacao          String?

  @@index([ativoId, realizadoEm])
  @@map("movimentacao_ativo")
}

/// RESERVADA = entrega futura preparada (ninguém fica responsável). ATIVA = entrega física
/// confirmada, independente da assinatura do TER (Q-27).
enum EstadoAlocacao {
  RESERVADA
  ATIVA
  ENCERRADA
  CANCELADA
}

model Alocacao {
  id                   String               @id @default(uuid())
  /// Número legível: AL0001, AL0002... (sequência única, sem reinício anual). As anteriores
  /// mantêm o formato antigo (ALO-AAAA-NNNN) até haver migração específica autorizada.
  numero               String               @unique
  colaboradorId        String               @map("colaborador_id")
  colaborador          Colaborador          @relation(fields: [colaboradorId], references: [id])
  /// Empresa do colaborador na data da alocação. A proprietária de cada equipamento fica no item.
  empresaColaboradorId String               @map("empresa_colaborador_id")
  empresaColaborador   Empresa              @relation(fields: [empresaColaboradorId], references: [id])
  estado               EstadoAlocacao
  /// Reserva: data prevista da entrega.
  previstaPara         DateTime?            @map("prevista_para") @db.Date
  /// Entrega física (obrigatória a partir de ATIVA).
  entregueEm           DateTime?            @map("entregue_em")
  entreguePorNome      String?              @map("entregue_por_nome")
  observacoes          String?
  chaveRequisicao      String?              @unique @map("chave_requisicao")
  /// Responsável TI escolhido na alocação (membro da TI ativo e autorizado); nulo nas anteriores.
  responsavelTiContaId String?              @map("responsavel_ti_conta_id")
  responsavelTi        ContaAcesso?         @relation("ResponsavelTiAlocacao", fields: [responsavelTiContaId], references: [id])
  responsavelTiNome    String?              @map("responsavel_ti_nome")
  /// Quem registrou a operação no portal (pode ser diferente do responsável TI).
  criadaPorContaId     String?              @map("criada_por_conta_id")
  criadaPorNome        String               @map("criada_por_nome")
  criadaEm             DateTime             @default(now()) @map("criada_em")
  atualizadaEm         DateTime             @default(now()) @updatedAt @map("atualizada_em")
  canceladaEm          DateTime?            @map("cancelada_em")
  motivoCancelamento   String?              @map("motivo_cancelamento")
  itens                ItemAlocacao[]
  devolucoes           Devolucao[]
  termos               Termo[]
  inspecoes            InspecaoTecnica[]
  verificacoes         VerificacaoEntrega[]
  eventosEntrega       EventoEntrega[]

  @@index([colaboradorId])
  @@index([estado])
  @@index([empresaColaboradorId])
  @@map("alocacao")
}

enum MotivoEncerramentoItem {
  DEVOLUCAO
  MANUTENCAO
  CANCELAMENTO
  SUBSTITUICAO
  TRANSFERENCIA
}

/// Equipamento dentro de uma alocação. "aberto" é true enquanto o item vale e nulo depois:
/// o índice único (ativo, aberto) impede duas alocações ou reservas abertas do mesmo equipamento.
model ItemAlocacao {
  id                    String                  @id @default(uuid())
  alocacaoId            String                  @map("alocacao_id")
  alocacao              Alocacao                @relation(fields: [alocacaoId], references: [id])
  ativoId               String                  @map("ativo_id")
  ativo                 Ativo                   @relation(fields: [ativoId], references: [id])
  /// Empresa proprietária do equipamento na data da alocação (instantâneo).
  empresaProprietariaId String                  @map("empresa_proprietaria_id")
  empresaProprietaria   Empresa                 @relation(fields: [empresaProprietariaId], references: [id])
  aberto                Boolean?                @default(true)
  encerradoEm           DateTime?               @map("encerrado_em")
  motivoEncerramento    MotivoEncerramentoItem? @map("motivo_encerramento")
  encerradoPorNome      String?                 @map("encerrado_por_nome")
  manutencaoId          String?                 @map("manutencao_id")
  itemDevolucao         ItemDevolucao?
  /// Condição verificada na entrega física (instantâneo imutável para o TER).
  verificacaoEntrega    VerificacaoEntrega?

  @@unique([ativoId, aberto])
  @@index([alocacaoId])
  @@map("item_alocacao")
}

enum AbrangenciaDevolucao {
  TOTAL
  PARCIAL
}

enum EstadoFisico {
  EXCELENTE
  BOM
  REGULAR
  DANIFICADO
}

/// Devolução nunca leva o equipamento direto para "disponível": passa por avaliação ou manutenção.
enum DestinoDevolucao {
  AVALIACAO
  MANUTENCAO
}

model Devolucao {
  id              String               @id @default(uuid())
  /// Número legível (DEV-AAAA-NNNN).
  numero          String               @unique
  alocacaoId      String               @map("alocacao_id")
  alocacao        Alocacao             @relation(fields: [alocacaoId], references: [id])
  colaboradorId   String               @map("colaborador_id")
  colaborador     Colaborador          @relation(fields: [colaboradorId], references: [id])
  abrangencia     AbrangenciaDevolucao
  recebidaEm      DateTime             @map("recebida_em")
  recebidaPorNome String               @map("recebida_por_nome")
  observacoes     String?
  chaveRequisicao String?              @unique @map("chave_requisicao")
  criadaEm        DateTime             @default(now()) @map("criada_em")
  itens           ItemDevolucao[]
  termos          Termo[]
  inspecoes       InspecaoTecnica[]

  @@index([alocacaoId])
  @@map("devolucao")
}

model ItemDevolucao {
  id             String           @id @default(uuid())
  devolucaoId    String           @map("devolucao_id")
  devolucao      Devolucao        @relation(fields: [devolucaoId], references: [id])
  itemAlocacaoId String           @unique @map("item_alocacao_id")
  itemAlocacao   ItemAlocacao     @relation(fields: [itemAlocacaoId], references: [id])
  estadoFisico   EstadoFisico     @map("estado_fisico")
  destino        DestinoDevolucao
  observacoes    String?
  fotos          FotoAtivo[]

  @@map("item_devolucao")
}

enum TipoTransferencia {
  COLABORADOR
  EMPRESA
}

enum EstadoTransferencia {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

/// Transferência do equipamento: de custódia (entre colaboradores) ou de propriedade (entre
/// empresas). Só a de colaborador fica pendente: reserva antes da entrega física, com a custódia
/// atual mantida (Q-27). Origem e destino ficam como instantâneo (ids e nomes). Nunca é apagada.
model Transferencia {
  id                     String              @id @default(uuid())
  ativoId                String              @map("ativo_id")
  ativo                  Ativo               @relation(fields: [ativoId], references: [id])
  tipo                   TipoTransferencia
  estado                 EstadoTransferencia
  /// true enquanto pendente e nulo depois: o índice único impede duas pendentes do mesmo equipamento.
  pendente               Boolean?            @default(true)
  colaboradorOrigemId    String?             @map("colaborador_origem_id")
  colaboradorOrigemNome  String?             @map("colaborador_origem_nome")
  colaboradorDestinoId   String?             @map("colaborador_destino_id")
  colaboradorDestinoNome String?             @map("colaborador_destino_nome")
  alocacaoOrigemId       String?             @map("alocacao_origem_id")
  alocacaoDestinoId      String?             @map("alocacao_destino_id")
  empresaOrigemId        String?             @map("empresa_origem_id")
  empresaOrigemNome      String?             @map("empresa_origem_nome")
  empresaDestinoId       String?             @map("empresa_destino_id")
  empresaDestinoNome     String?             @map("empresa_destino_nome")
  /// Empresa: obrigatório. Colaborador: observação opcional.
  motivo                 String?
  /// Pendente: data prevista da entrega física.
  previstaPara           DateTime?           @map("prevista_para") @db.Date
  /// Entrega física (colaborador) ou mudança de propriedade (empresa).
  efetivadaEm            DateTime?           @map("efetivada_em")
  realizadaPorContaId    String?             @map("realizada_por_conta_id")
  realizadaPorNome       String              @map("realizada_por_nome")
  criadaEm               DateTime            @default(now()) @map("criada_em")
  concluidaPorNome       String?             @map("concluida_por_nome")
  canceladaEm            DateTime?           @map("cancelada_em")
  canceladaPorNome       String?             @map("cancelada_por_nome")
  motivoCancelamento     String?             @map("motivo_cancelamento")
  /// O mesmo envio repetido (duplo clique, nova tentativa) devolve a transferência já registrada.
  chaveRequisicao        String?             @unique @map("chave_requisicao")

  @@unique([ativoId, pendente])
  @@index([ativoId, criadaEm])
  @@map("transferencia")
}

/// Aluguel do equipamento a outra empresa do grupo. A propriedade não muda; enquanto o aluguel
/// vale, só colaboradores da empresa locatária recebem o equipamento (e os carregadores
/// vinculados, da mesma dona). A data prevista de devolução é só um prazo: o aluguel termina
/// pelo encerramento registrado, nunca sozinho.
model AluguelEquipamento {
  id                    String    @id @default(uuid())
  ativoId               String    @map("ativo_id")
  ativo                 Ativo     @relation(fields: [ativoId], references: [id])
  /// Proprietária no início do aluguel (a propriedade não muda enquanto ele vale).
  empresaProprietariaId String    @map("empresa_proprietaria_id")
  empresaProprietaria   Empresa   @relation("AlugueisCedidos", fields: [empresaProprietariaId], references: [id])
  empresaLocatariaId    String    @map("empresa_locataria_id")
  empresaLocataria      Empresa   @relation("AlugueisRecebidos", fields: [empresaLocatariaId], references: [id])
  inicio                DateTime  @db.Date
  devolucaoPrevista     DateTime? @map("devolucao_prevista") @db.Date
  motivo                String
  observacoes           String?
  /// true enquanto vigente e nulo depois: o índice único impede dois aluguéis vigentes do mesmo equipamento.
  vigente               Boolean?  @default(true)
  registradoEm          DateTime  @default(now()) @map("registrado_em")
  registradoPorContaId  String?   @map("registrado_por_conta_id")
  registradoPorNome     String    @map("registrado_por_nome")
  encerradoEm           DateTime? @map("encerrado_em")
  encerradoPorContaId   String?   @map("encerrado_por_conta_id")
  encerradoPorNome      String?   @map("encerrado_por_nome")
  motivoEncerramento    String?   @map("motivo_encerramento")
  /// O mesmo envio repetido devolve o aluguel já registrado.
  chaveRequisicao       String?   @unique @map("chave_requisicao")

  @@unique([ativoId, vigente])
  @@index([empresaLocatariaId, vigente])
  @@index([ativoId, inicio])
  @@map("aluguel_equipamento")
}

enum TipoComponente {
  MEMORIA_RAM
  SSD
  HD
}

enum TipoIntervencao {
  CONFIGURACAO_ORIGINAL
  INSTALACAO
  REMOCAO
  SUBSTITUICAO
}

/// Intervenção na configuração de um notebook: configuração original informada, instalação,
/// remoção ou substituição de peças. Guarda a configuração anterior e a resultante e nunca é
/// alterada nem apagada.
model IntervencaoConfiguracao {
  id                     String             @id @default(uuid())
  equipamentoId          String             @map("equipamento_id")
  equipamento            Ativo              @relation(fields: [equipamentoId], references: [id])
  tipo                   TipoIntervencao
  motivo                 String?
  configuracaoAnterior   String?            @map("configuracao_anterior")
  configuracaoResultante String             @map("configuracao_resultante")
  /// Notebook alocado: com quem estava (a alocação não muda por troca de peça).
  colaboradorNome        String?            @map("colaborador_nome")
  alocacaoNumero         String?            @map("alocacao_numero")
  realizadaEm            DateTime           @map("realizada_em")
  realizadaPorContaId    String?            @map("realizada_por_conta_id")
  realizadaPorNome       String             @map("realizada_por_nome")
  criadaEm               DateTime           @default(now()) @map("criada_em")
  chaveRequisicao        String?            @unique @map("chave_requisicao")
  pecasInstaladas        PecaConfiguracao[] @relation("PecaInstalada")
  pecasRemovidas         PecaConfiguracao[] @relation("PecaRemovida")

  @@index([equipamentoId, realizadaEm])
  @@map("intervencao_configuracao")
}

/// Peça da configuração de um notebook: original (só a especificação, sem identificação
/// individual) ou componente físico do estoque (RAM001, SSD001...). "vigente" é true enquanto a
/// peça está no notebook e nulo depois: o índice único impede o mesmo componente em dois
/// equipamentos. A configuração atual é a soma das peças vigentes, sem somar a original com a
/// peça que a substituiu.
model PecaConfiguracao {
  id               String                   @id @default(uuid())
  equipamentoId    String                   @map("equipamento_id")
  equipamento      Ativo                    @relation("PecasEquipamento", fields: [equipamentoId], references: [id])
  tipo             TipoComponente
  /// Componente individual. Peça original: nulo, até ser identificada ao entrar no estoque na remoção.
  componenteId     String?                  @map("componente_id")
  componente       Ativo?                   @relation("PecasComponente", fields: [componenteId], references: [id])
  original         Boolean                  @default(false)
  capacidadeGb     Int                      @map("capacidade_gb")
  tecnologia       String?
  interfaceConexao String?                  @map("interface_conexao")
  formato          String?
  vigente          Boolean?                 @default(true)
  instaladaEm      DateTime                 @map("instalada_em")
  instaladaPorNome String                   @map("instalada_por_nome")
  instaladaNaId    String                   @map("instalada_na_id")
  instaladaNa      IntervencaoConfiguracao  @relation("PecaInstalada", fields: [instaladaNaId], references: [id])
  removidaEm       DateTime?                @map("removida_em")
  removidaPorNome  String?                  @map("removida_por_nome")
  removidaNaId     String?                  @map("removida_na_id")
  removidaNa       IntervencaoConfiguracao? @relation("PecaRemovida", fields: [removidaNaId], references: [id])
  motivoRemocao    String?                  @map("motivo_remocao")
  /// Destino da peça removida que entrou no estoque: disponível, avaliação, manutenção ou baixa.
  destinoRemocao   SituacaoAtivo?           @map("destino_remocao")

  @@unique([componenteId, vigente])
  @@index([equipamentoId, vigente])
  @@map("peca_configuracao")
}

enum ResultadoManutencao {
  REPARADO
  SEM_REPARO
}

/// "aberta" é true até a conclusão e nula depois: uma só manutenção aberta por equipamento.
model Manutencao {
  id                       String               @id @default(uuid())
  ativoId                  String               @map("ativo_id")
  ativo                    Ativo                @relation(fields: [ativoId], references: [id])
  aberta                   Boolean?             @default(true)
  motivo                   String
  observacoes              String
  abertaEm                 DateTime             @default(now()) @map("aberta_em")
  abertaPorNome            String               @map("aberta_por_nome")
  /// Equipamento recolhido de um colaborador: quem estava com ele e a confirmação física.
  recolhidoDeId            String?              @map("recolhido_de_id")
  recolhidoDeNome          String?              @map("recolhido_de_nome")
  recolhimentoConfirmadoEm DateTime?            @map("recolhimento_confirmado_em")
  devolucaoId              String?              @map("devolucao_id")
  concluidaEm              DateTime?            @map("concluida_em")
  concluidaPorNome         String?              @map("concluida_por_nome")
  servicoRealizado         String?              @map("servico_realizado")
  resultado                ResultadoManutencao?
  fotos                    FotoAtivo[]

  @@unique([ativoId, aberta])
  @@index([abertaEm])
  @@map("manutencao")
}

enum TipoTermo {
  TER
  TDV
}

enum EstadoTermo {
  RASCUNHO
  EMITIDO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

/// TER e TDV têm ciclo próprio: nenhuma mudança no termo altera alocação ou equipamento.
/// ASSINADO exige o PDF assinado guardado (restrição no banco).
model Termo {
  id                        String               @id @default(uuid())
  numero                    String               @unique
  tipo                      TipoTermo
  alocacaoId                String?              @map("alocacao_id")
  alocacao                  Alocacao?            @relation(fields: [alocacaoId], references: [id])
  devolucaoId               String?              @map("devolucao_id")
  devolucao                 Devolucao?           @relation(fields: [devolucaoId], references: [id])
  colaboradorId             String               @map("colaborador_id")
  colaborador               Colaborador          @relation(fields: [colaboradorId], references: [id])
  estado                    EstadoTermo
  versaoModelo              String?              @map("versao_modelo")
  emitidoEm                 DateTime?            @map("emitido_em")
  /// TER emitido pelo portal: um por evento de entrega física (as versões ficam em VersaoTer).
  eventoEntregaId           String?              @unique @map("evento_entrega_id")
  eventoEntrega             EventoEntrega?       @relation(fields: [eventoEntregaId], references: [id])
  /// Empresa responsável (a do colaborador na entrega).
  empresaId                 String?              @map("empresa_id")
  empresa                   Empresa?             @relation(fields: [empresaId], references: [id])
  estadoDocumento           EstadoDocumentoTer?  @map("estado_documento")
  estadoAssinatura          EstadoAssinaturaTer? @map("estado_assinatura")
  /// Versão documental vigente (as anteriores ficam como substituídas).
  versaoVigente             Int?                 @map("versao_vigente")
  canceladoPorNome          String?              @map("cancelado_por_nome")
  motivoCancelamento        String?              @map("motivo_cancelamento")
  /// TER assinado e conferido: referência do procedimento administrativo que autorizou o cancelamento.
  procedimentoCancelamento  String?              @map("procedimento_cancelamento")
  versoes                   VersaoTer[]
  envios                    EnvioTer[]
  arquivosAssinados         ArquivoAssinadoTer[]
  conferencias              ConferenciaTer[]
  historico                 HistoricoTer[]
  arquivoAssinadoChave      String?              @unique @map("arquivo_assinado_chave")
  sha256Assinado            String?              @map("sha256_assinado")
  assinadoRegistradoEm      DateTime?            @map("assinado_registrado_em")
  assinadoRegistradoPorNome String?              @map("assinado_registrado_por_nome")
  disponivelAoColaborador   Boolean              @default(false) @map("disponivel_ao_colaborador")
  canceladoEm               DateTime?            @map("cancelado_em")
  criadoEm                  DateTime             @default(now()) @map("criado_em")

  @@index([alocacaoId])
  @@index([devolucaoId])
  @@index([colaboradorId])
  @@index([empresaId])
  @@map("termo")
}

/// Numeração sequencial de documentos (ALO-2026, DEV-2026, TER-2026...), incrementada de forma atômica.
model ContadorDocumento {
  chave String @id
  valor Int

  @@map("contador_documento")
}

/**
 * Inspeções técnicas: questionários versionados por categoria, inspeções de entrada,
 * devolução e pré-alocação (nunca sobrescritas) e a verificação de cada item na entrega física.
 */

/// Condição do equipamento na entrada: o novo não passa pelos testes que só valem para usados.
enum CondicaoEntrada {
  NOVO
  USADO
}

enum TipoInspecao {
  ENTRADA
  DEVOLUCAO
  PRE_ALOCACAO
}

/// PENDENTE = aberta na entrada em avaliação, aguardando a TI; CANCELADA = o equipamento saiu da avaliação por outro caminho.
enum EstadoInspecao {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

/// Calculado das respostas no servidor: não conforme em item bloqueante = INAPTO.
enum ResultadoInspecao {
  APTO
  APTO_COM_RESSALVAS
  INAPTO
}

enum RespostaChecklist {
  CONFORME
  NAO_CONFORME
  NAO_TESTADO
  NAO_SE_APLICA
}

enum ModoVerificacaoEntrega {
  /// As condições continuam iguais às da última inspeção.
  CONFIRMOU_ULTIMA
  /// Nova inspeção feita na alocação.
  NOVA_INSPECAO
}

/// Versão fixa de questionário da primeira etapa (antes do checklist configurável). Só histórico:
/// as inspeções novas apontam, em cada resposta, para a versão da pergunta exibida.
model QuestionarioInspecao {
  id        String            @id @default(uuid())
  codigo    String
  versao    Int
  titulo    String
  /// Perguntas da versão com as orientações (como testar, resultado esperado, sinais de problema).
  perguntas Json
  /// SHA-256 da definição: a mesma versão nunca muda de conteúdo.
  hash      String
  criadoEm  DateTime          @default(now()) @map("criado_em")
  inspecoes InspecaoTecnica[]

  @@unique([codigo, versao])
  @@map("questionario_inspecao")
}

/// Inspeção técnica de um equipamento. Concluída, não muda nem é excluída; a seguinte é sempre outra linha.
/// "pendente" é true enquanto aguarda a TI e nulo depois: uma só pendente por equipamento.
model InspecaoTecnica {
  id                   String                @id @default(uuid())
  /// Número legível (INS-AAAA-NNNN), atribuído na conclusão.
  numero               String?               @unique
  ativoId              String                @map("ativo_id")
  ativo                Ativo                 @relation(fields: [ativoId], references: [id])
  tipo                 TipoInspecao
  estado               EstadoInspecao
  pendente             Boolean?              @default(true)
  /// Categoria e questionário usados (instantâneo na conclusão).
  categoria            CategoriaAtivo?
  categoriaNome        String?               @map("categoria_nome")
  questionarioId       String?               @map("questionario_id")
  questionario         QuestionarioInspecao? @relation(fields: [questionarioId], references: [id])
  condicaoEntrada      CondicaoEntrada?      @map("condicao_entrada")
  resultado            ResultadoInspecao?
  observacoes          String?
  devolucaoId          String?               @map("devolucao_id")
  devolucao            Devolucao?            @relation(fields: [devolucaoId], references: [id])
  alocacaoId           String?               @map("alocacao_id")
  alocacao             Alocacao?             @relation(fields: [alocacaoId], references: [id])
  abertaEm             DateTime              @default(now()) @map("aberta_em")
  abertaPorNome        String                @map("aberta_por_nome")
  motivoAbertura       String?               @map("motivo_abertura")
  concluidaEm          DateTime?             @map("concluida_em")
  /// Membro da TI que fez a inspeção.
  responsavelContaId   String?               @map("responsavel_conta_id")
  responsavelNome      String?               @map("responsavel_nome")
  canceladaEm          DateTime?             @map("cancelada_em")
  motivoCancelamento   String?               @map("motivo_cancelamento")
  respostas            RespostaInspecao[]
  fotos                FotoAtivo[]
  verificacoes         VerificacaoEntrega[]
  /// Perguntas opcionais que ficaram sem resposta (versão e texto exibidos): nada é presumido.
  perguntasSemResposta Json?                 @map("perguntas_sem_resposta")

  @@unique([ativoId, pendente])
  @@index([ativoId, concluidaEm])
  @@map("inspecao_tecnica")
}

/// Resposta a uma pergunta, com o texto da pergunta como foi exibido (instantâneo). Somente inserção.
/// "chave" é o id da pergunta (estável entre versões); a versão exibida fica em versaoPerguntaId.
model RespostaInspecao {
  id               String                  @id @default(uuid())
  inspecaoId       String                  @map("inspecao_id")
  inspecao         InspecaoTecnica         @relation(fields: [inspecaoId], references: [id])
  versaoPerguntaId String?                 @map("versao_pergunta_id")
  versaoPergunta   VersaoPerguntaInspecao? @relation(fields: [versaoPerguntaId], references: [id], onDelete: Restrict)
  chave            String
  ordem            Int
  grupo            String
  pergunta         String
  bloqueante       Boolean
  /// Verificação normalmente aplicável: "Não se aplica" exige justificativa.
  obrigatoria      Boolean
  resposta         RespostaChecklist
  justificativa    String?
  observacao       String?
  fotos            FotoAtivo[]

  @@unique([inspecaoId, chave])
  @@map("resposta_inspecao")
}

/// Verificação técnica de um item na entrega física: aponta a inspeção usada e guarda o instantâneo
/// (identificação, versão do questionário, perguntas e respostas confirmadas) para o TER. Imutável.
model VerificacaoEntrega {
  id                 String                 @id @default(uuid())
  itemAlocacaoId     String                 @unique @map("item_alocacao_id")
  itemAlocacao       ItemAlocacao           @relation(fields: [itemAlocacaoId], references: [id])
  alocacaoId         String                 @map("alocacao_id")
  alocacao           Alocacao               @relation(fields: [alocacaoId], references: [id])
  ativoId            String                 @map("ativo_id")
  ativo              Ativo                  @relation(fields: [ativoId], references: [id])
  inspecaoId         String                 @map("inspecao_id")
  inspecao           InspecaoTecnica        @relation(fields: [inspecaoId], references: [id])
  modo               ModoVerificacaoEntrega
  instantaneo        Json
  verificadaEm       DateTime               @map("verificada_em")
  responsavelContaId String                 @map("responsavel_conta_id")
  responsavelNome    String                 @map("responsavel_nome")
  /// Evento de entrega física em que o item foi entregue (o TER desse evento o documenta).
  eventoEntregaId    String?                @map("evento_entrega_id")
  eventoEntrega      EventoEntrega?         @relation(fields: [eventoEntregaId], references: [id])

  @@index([alocacaoId])
  @@index([inspecaoId])
  @@index([eventoEntregaId])
  @@map("verificacao_entrega")
}

/// Quando a pergunta vale: em todas as inspeções, fora da entrada de equipamento novo (testes de
/// usado) ou só depois do cadastro (ex.: etiqueta do portal, que nasce no cadastro).
enum AplicacaoPergunta {
  SEMPRE
  EXCETO_ENTRADA_NOVO
  APOS_CADASTRO
}

/// Pergunta do checklist de uma categoria, configurada pela TI. Ordem e situação mudam aqui;
/// o conteúdo (texto, orientações e regras) muda só por nova versão.
model PerguntaInspecao {
  id            String                   @id @default(uuid())
  /// Perguntas do checklist inicial (ex.: "MONITOR:mn.tela"); as criadas pela TI não têm.
  codigo        String?                  @unique
  categoriaId   String                   @map("categoria_id")
  categoria     CategoriaEquipamento     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  ordem         Int
  ativa         Boolean                  @default(true)
  criadaEm      DateTime                 @default(now()) @map("criada_em")
  criadaPorNome String                   @map("criada_por_nome")
  atualizadaEm  DateTime                 @default(now()) @updatedAt @map("atualizada_em")
  versoes       VersaoPerguntaInspecao[]

  @@index([categoriaId, ordem])
  @@map("pergunta_inspecao")
}

/// Conteúdo de uma pergunta em uma versão. Não muda depois de gravado: editar cria a próxima
/// versão e as respostas antigas continuam apontando para a delas.
model VersaoPerguntaInspecao {
  id                String             @id @default(uuid())
  perguntaId        String             @map("pergunta_id")
  pergunta          PerguntaInspecao   @relation(fields: [perguntaId], references: [id], onDelete: Restrict)
  versao            Int
  grupo             String
  texto             String
  comoTestar        String             @map("como_testar")
  resultadoEsperado String             @map("resultado_esperado")
  sinaisProblema    String             @map("sinais_problema")
  /// Obrigatória: precisa de resposta explícita; "Não se aplica" pede justificativa.
  obrigatoria       Boolean
  /// "Não conforme" aqui é defeito bloqueante (impede aprovação, liberação e entrega).
  bloqueante        Boolean
  aplicacao         AplicacaoPergunta
  /// Kit: peças a que a pergunta se aplica (vazio = todas).
  partes            ParteKit[]         @default([])
  criadaEm          DateTime           @default(now()) @map("criada_em")
  criadaPorNome     String             @map("criada_por_nome")
  respostas         RespostaInspecao[]

  @@unique([perguntaId, versao])
  @@map("versao_pergunta_inspecao")
}

/**
 * TER emitido pelo portal (Termo de Entrega, Guarda e Responsabilidade): um por evento de
 * entrega física, com versões documentais imutáveis depois de emitidas, encaminhamentos,
 * arquivos assinados recebidos, conferências e histórico. A assinatura é externa (GOV.BR) e só
 * vale depois de conferida pela TI.
 */

enum TipoEventoEntrega {
  NOVA_ALOCACAO
  CONFIRMACAO_RESERVA
  TRANSFERENCIA
  ENTREGA_ADICIONAL
}

enum EstadoDocumentoTer {
  GERANDO
  ERRO_GERACAO
  EMITIDO
  CANCELADO
  SUBSTITUIDO
}

enum EstadoAssinaturaTer {
  AGUARDANDO_ENVIO
  AGUARDANDO_ASSINATURA
  ARQUIVO_RECEBIDO
  ASSINADO_CONFERIDO
  ASSINATURA_RECUSADA
  VALIDACAO_INDETERMINADA
}

enum OrigemArquivoTer {
  TI
  PORTAL_COLABORADOR
}

enum ResultadoConferencia {
  CONFORME
  NAO_CONFORME
  INDETERMINADO
}

/// Entrega física (o evento que gera o TER): quem recebeu, quando, quem respondeu pela TI e o
/// instantâneo dos itens entregues (proprietária, aluguel). As verificações técnicas dos itens
/// apontam para ele.
model EventoEntrega {
  id                   String               @id @default(uuid())
  alocacaoId           String               @map("alocacao_id")
  alocacao             Alocacao             @relation(fields: [alocacaoId], references: [id])
  tipo                 TipoEventoEntrega
  entregueEm           DateTime             @map("entregue_em")
  colaboradorId        String               @map("colaborador_id")
  empresaColaboradorId String               @map("empresa_colaborador_id")
  responsavelTiNome    String               @map("responsavel_ti_nome")
  registradoPorContaId String?              @map("registrado_por_conta_id")
  registradoPorNome    String               @map("registrado_por_nome")
  /// Instantâneo dos itens entregues (identificação, proprietária e aluguel na data).
  itens                Json
  criadoEm             DateTime             @default(now()) @map("criado_em")
  verificacoes         VerificacaoEntrega[]
  termo                Termo?

  @@index([alocacaoId])
  @@map("evento_entrega")
}

/// Versão documental do TER. Emitida, não muda: correção é uma nova versão (a anterior fica
/// substituída e o PDF dela continua guardado).
model VersaoTer {
  id             String             @id @default(uuid())
  termoId        String             @map("termo_id")
  termo          Termo              @relation(fields: [termoId], references: [id])
  versao         Int
  estado         EstadoDocumentoTer
  /// Motivo da versão (emissão inicial ou correção).
  motivo         String
  /// Instantâneo documental do que o PDF mostra (sem CPF: o número só entra no PDF).
  dados          Json?
  modeloCodigo   String             @map("modelo_codigo")
  modeloRevisao  String             @map("modelo_revisao")
  arquivoChave   String?            @unique @map("arquivo_chave")
  sha256         String?
  tamanho        Int?
  paginas        Int?
  nomeArquivo    String?            @map("nome_arquivo")
  /// Emitido fora de produção (ou com dados de teste): o PDF é marcado como documento de teste, sem validade.
  documentoTeste Boolean            @default(false) @map("documento_teste")
  erro           String?
  /// Dados obrigatórios ausentes no cadastro de origem (ex.: CPF): a versão espera a correção.
  pendencias     String[]           @default([])
  tentativas     Int                @default(0)
  criadaEm       DateTime           @default(now()) @map("criada_em")
  criadaPorNome  String             @map("criada_por_nome")
  emitidaEm      DateTime?          @map("emitida_em")
  emitidaPorNome String?            @map("emitida_por_nome")

  @@unique([termoId, versao])
  @@map("versao_ter")
}

/// Encaminhamento para assinatura (envio ou reenvio). Sem serviço de e-mail no portal, o
/// encaminhamento é feito fora dele e registrado aqui. Sempre o PDF da versão indicada.
model EnvioTer {
  id                   String   @id @default(uuid())
  termoId              String   @map("termo_id")
  termo                Termo    @relation(fields: [termoId], references: [id])
  versao               Int
  reenvio              Boolean
  canal                String
  destinatario         String
  mensagem             String
  /// SHA-256 do PDF encaminhado (o mesmo da versão emitida).
  sha256               String
  observacao           String?
  /// Quando o encaminhamento foi feito (fora do portal), informado por quem registra.
  enviadoEm            DateTime @map("enviado_em")
  registradoEm         DateTime @default(now()) @map("registrado_em")
  registradoPorContaId String?  @map("registrado_por_conta_id")
  registradoPorNome    String   @map("registrado_por_nome")

  @@index([termoId])
  @@map("envio_ter")
}

/// PDF assinado recebido, guardado como chegou (nunca alterado). Cada envio é um registro.
model ArquivoAssinadoTer {
  id                String           @id @default(uuid())
  termoId           String           @map("termo_id")
  termo             Termo            @relation(fields: [termoId], references: [id])
  versao            Int
  chave             String           @unique
  nomeOriginal      String           @map("nome_original")
  tamanho           Int
  sha256            String
  recebidoEm        DateTime         @default(now()) @map("recebido_em")
  enviadoPorContaId String?          @map("enviado_por_conta_id")
  enviadoPorNome    String           @map("enviado_por_nome")
  /// Quem trouxe o arquivo: a TI (recebido por fora) ou o próprio colaborador, pelo portal.
  origem            OrigemArquivoTer @default(TI)
  conferencias      ConferenciaTer[]

  @@index([termoId])
  @@map("arquivo_assinado_ter")
}

/// Conferência manual da assinatura (validador oficial, signatário e correspondência com o
/// documento emitido). Só "conforme" com as verificações marcadas torna o TER assinado.
model ConferenciaTer {
  id                     String               @id @default(uuid())
  termoId                String               @map("termo_id")
  termo                  Termo                @relation(fields: [termoId], references: [id])
  arquivoId              String               @map("arquivo_id")
  arquivo                ArquivoAssinadoTer   @relation(fields: [arquivoId], references: [id])
  resultado              ResultadoConferencia
  ferramenta             String
  signatario             String?
  confereColaborador     Boolean              @map("confere_colaborador")
  confereDocumento       Boolean              @map("confere_documento")
  assinaturaTiVerificada Boolean?             @map("assinatura_ti_verificada")
  relatorioChave         String?              @unique @map("relatorio_chave")
  observacoes            String?
  motivo                 String?
  conferidaEm            DateTime             @default(now()) @map("conferida_em")
  conferidaPorContaId    String?              @map("conferida_por_conta_id")
  conferidaPorNome       String               @map("conferida_por_nome")

  @@index([termoId])
  @@map("conferencia_ter")
}

/// Histórico do TER (somente inserção): geração, emissão, envios, anexos, conferências,
/// cancelamento e substituições, com autor, data e motivo.
model HistoricoTer {
  id                 String   @id @default(uuid())
  termoId            String   @map("termo_id")
  termo              Termo    @relation(fields: [termoId], references: [id])
  versao             Int?
  acao               String
  detalhe            String?
  responsavelContaId String?  @map("responsavel_conta_id")
  responsavelNome    String   @map("responsavel_nome")
  em                 DateTime @default(now())

  @@index([termoId, em])
  @@map("historico_ter")
}

/// Modelo documental aprovado (código, revisão e declarações). O texto jurídico não é editado
/// pelo portal: uma revisão nova entra por migração depois de aprovada.
model ModeloDocumento {
  id                String    @id @default(uuid())
  tipo              TipoTermo
  codigo            String
  revisao           String
  titulo            String
  declaracoes       Json
  /// Exige também a assinatura do responsável pela entrega para concluir a conferência.
  exigeAssinaturaTi Boolean   @default(false) @map("exige_assinatura_ti")
  ativo             Boolean   @default(true)
  criadoEm          DateTime  @default(now()) @map("criado_em")

  @@unique([tipo, codigo, revisao])
  @@map("modelo_documento")
}
